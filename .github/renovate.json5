// Renovate's shared rules come from the owner's preset repository.
{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"github>donvargax/renovate-config#v1.3.0",
		"github>donvargax/renovate-config:go#v1.3.0",
	],
	enabledManagers: ["gomod", "github-actions", "renovate-config", "custom.regex"],

	// Every update lands through its own pull request, and GitHub's rebase merge keeps Renovate's
	// message as written. The default strategy picks a squash, which appends a Co-authored-by
	// paragraph to the message.
	automergeType: "pr",
	automergeStrategy: "rebase",
	automergeSchedule: ["at any time"],
	semanticCommits: "enabled",
	commitBody: "Renovate's update, landed on {{{baseBranch}}} once CI passed on its pull request.\n\n{{#each upgrades}}{{#unless @first}}\n{{/unless}}- {{{depName}}} {{#if (equals updateType 'digest')}}{{{currentDigestShort}}} to {{{newDigestShort}}}{{else}}{{{currentVersion}}} to {{{newVersion}}}{{#if newDigestShort}} ({{{newDigestShort}}}){{/if}}{{/if}}{{/each}}",

	// Renovate proposes versions of the tools pinned in tools/bin/pinned. It cannot read a
	// release asset's numeric ID, so the match covers the version line alone. A bump leaves the
	// old checksums, so its pull request goes red until a person refreshes them (docs/upgrading.md).
	customManagers: [
		{
			customType: "regex",
			managerFilePatterns: ["/^tools/bin/pinned$/"],
			matchStrings: ["# renovate: depName=(?<depName>\\S+)\\n\\t+version=(?<currentValue>\\S+)\\n"],
			datasourceTemplate: "github-releases",
			extractVersionTemplate: "^v?(?<version>.+)$",
		},
		{
			// The image's base in .goreleaser.yaml: its tag stays and its digest moves.
			customType: "regex",
			managerFilePatterns: ["/^\\.goreleaser\\.yaml$/"],
			matchStrings: ["base_image: (?<depName>\\S+?):(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\n"],
			datasourceTemplate: "docker",
		},
	],

	packageRules: [
		{
			matchPackageNames: ["*"],
			semanticCommitType: "build",
			semanticCommitScope: null,
		},
		{
			matchManagers: ["github-actions", "renovate-config"],
			semanticCommitType: "ci",
			semanticCommitScope: null,
		},
		{
			matchManagers: ["github-actions"],
			pinDigests: true,
		},
		{
			// A Go release moves go.mod's toolchain line as soon as CI passes on its pull request.
			matchManagers: ["gomod"],
			matchDepTypes: ["toolchain"],
			minimumReleaseAge: null,
			schedule: ["at any time"],
		},
		{
			// One dependency's updates share a branch name, so they move together.
			matchPackageNames: ["*"],
			groupName: "{{depName}}",
		},
	],
}
