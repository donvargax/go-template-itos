#!/bin/sh
# Build with this repository's pinned module, inspect the caller's current module.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# GOEXE is .exe on Windows, where a program must carry it to be run by name.
exe=$(go env GOEXE)
(cd "$root" && go build -o "$tmp/architecture-check$exe" ./tools/architecture/check) || exit 2
# The fixtures lint with the pinned linter; the path travels in the environment,
# which the shell converts for Windows.
ARCHITECTURE_LINTER=$(cd "$root" && tools/bin/pinned --path golangci-lint)
export ARCHITECTURE_LINTER
status=0
"$tmp/architecture-check$exe" "$@" || status=$?
exit "$status"
